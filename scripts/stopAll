#!/usr/bin/env bash
# 봇 2개와 Dev Tunnel 호스트를 전부 내린다.
#
#   ./scripts/stopAll
#
# 순서: roulette(3978) → vote(3979) → devtunnel host
# 봇을 먼저 내려야 진행 중인 요청이 살아 있는 터널을 통해 죽은 백엔드로 들어가지 않는다.
#
# 각 단계는 TERM 을 먼저 보내고 1.5초 안에 안 죽으면 KILL -9 로 확실히 끝낸다.
# uvicorn 이 asyncio.sleep 중일 때 TERM 을 늦게(또는 아예) 처리하지 않기 때문이다.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

parse_args "$@"
[ "$BG" = "1" ] && die "stopAll 에는 --bg 가 없다"

echo "▸ roulette-agent (포트 3978)"
stop_port 3978

echo "▸ vote-agent (포트 3979)"
stop_port 3979

echo "▸ devtunnel host"
stop_tunnel

# 정말로 다 내려갔는지 확인한다. 남아 있으면 다음 기동이 조용히 실패한다.
echo
leftover=0
for port in 3978 3979; do
    if lsof -t -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
        say "❌ 포트 $port 가 아직 잡혀 있다"
        leftover=1
    fi
done
if [ -n "$(tunnel_pids)" ]; then
    say "❌ devtunnel 이 아직 살아 있다 (PID $(tunnel_pids))"
    leftover=1
fi

if [ "$leftover" = "1" ]; then
    die "일부가 남았다. 직접 확인:
   lsof -nP -iTCP:3978 -sTCP:LISTEN
   lsof -nP -iTCP:3979 -sTCP:LISTEN
   ps -axo pid=,comm= | grep devtunnel"
fi

echo "✅ 전부 종료됐다."
echo "   다시 띄우려면: ./scripts/startHost --bg && ./scripts/startRoulette --bg && ./scripts/startVote --bg"
