{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.2",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "김민지 (Minji Kim)",
    "websiteUrl": "${{DEVELOPER_URL}}",
    "privacyUrl": "${{DEVELOPER_URL}}",
    "termsOfUseUrl": "${{DEVELOPER_URL}}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "투표만들기${{APP_NAME_SUFFIX}}",
    "full": "투표만들기 (실시간 투표 봇)"
  },
  "description": {
    "short": "채팅방에서 실시간으로 집계되는 투표를 만듭니다.",
    "full": "제목과 항목, 마감 시각, 복수 선택 여부를 지정해 투표를 만듭니다. 누군가 투표하면 카드가 즉시 갱신되어 채팅방 전원이 현재 집계와 각 항목의 투표자 이름을 함께 볼 수 있습니다."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": [
        "groupChat",
        "team",
        "personal"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsTargetedMessages": false,
      "commandLists": [
        {
          "scopes": [
            "groupChat",
            "team"
          ],
          "triggers": [
            "mention"
          ],
          "commands": [
            {
              "title": "@투표만들기",
              "description": "입력 폼을 엽니다. 제목을 함께 쓰면 미리 채워집니다.",
              "type": "prompt",
              "prompt": "회식 메뉴 선정"
            },
            {
              "title": "@투표만들기 + 줄바꿈 목록",
              "description": "첫 줄은 제목, 이후 각 줄은 항목. `마감: 금요일 18시` 와 `복수` 는 지시어입니다.",
              "type": "prompt",
              "prompt": "9/10(목) 회식 메뉴 선정\n땡땡식당\n무슨식당\n초밥집\n마감: 금요일 18시\n복수"
            }
          ]
        },
        {
          "scopes": [
            "personal"
          ],
          "commands": [
            {
              "title": "도움말",
              "description": "투표만들기 사용법을 안내합니다."
            }
          ]
        }
      ]
    }
  ],
  "composeExtensions": [],
  "configurableTabs": [],
  "staticTabs": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
