# ─── 당첨자뽑기 (roulette-agent) ───────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.

# STEP 1 에서 기록한 Bot ID (= Entra 앱의 Client ID)
CLIENT_ID=

# STEP 1 에서 기록한 클라이언트 시크릿
CLIENT_SECRET=

# ⚠️ 등록 경로에 따라 다르다. 잘못 맞추면 401 이 난다.
#   경로 A (Teams 개발자 포털, 멀티테넌트) -> 비워 둔다
#   경로 B (Azure Bot, 단일 테넌트)        -> 디렉터리(테넌트) ID 를 넣는다
TENANT_ID=

# Dev Tunnel 포트와 짝이다. 바꾸지 않는다.
PORT=3978

# STEP 5 의 build-package.sh 가 매니페스트를 채울 때 쓴다.
# 비워 두면 스크립트가 GUID 를 생성해서 여기에 적어 넣는다.
TEAMS_APP_ID=

# 테스트 중 이름 충돌을 피하려면 "(테스트)" 처럼 넣는다. 운영에서는 비워 둔다.
APP_NAME_SUFFIX=
